---
// 引入全站布局组件
import BaseLayout from '../../layouts/BaseLayout.astro';
// 引入集合查询与内容渲染方法
import { getCollection, render } from 'astro:content';
// 引入 Astro 内置类型，用于 getStaticPaths 的类型标注
import type { GetStaticPaths } from 'astro';

// 生成全部静态路径：每篇文章对应一个 /blog/<id> 页面
export const getStaticPaths: GetStaticPaths = async () => {
  // 读取全部文章
  const posts = await getCollection('blog');
  // 把每篇文章映射成一条静态路径
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

// 从路由参数中取出当前文章对象
const { post } = Astro.props;
// 渲染 Markdown，得到可插入页面的组件
const { Content } = await render(post);
// 将日期格式化为「年-月-日」
const pubDate = post.data.pubDate.toISOString().slice(0, 10);
---

<!-- 使用全站布局，标题与描述取自文章数据 -->
<BaseLayout title={post.data.title} description={post.data.description}>
  <!-- 文章容器 -->
  <article class="post">
    <!-- 文章头部：标题与元信息 -->
    <header>
      <!-- 文章标题 -->
      <h1>{post.data.title}</h1>
      <!-- 元信息行：日期与标签 -->
      <div class="meta">
        <!-- 发布日期 -->
        <time datetime={post.data.pubDate.toISOString()}>{pubDate}</time>
        <!-- 标签列表 -->
        {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    </header>
    <!-- 正文内容：由 Markdown 渲染而来 -->
    <div class="content">
      <Content />
    </div>
    <!-- 返回列表 -->
    <p class="back"><a href="/blog">← 返回博客列表</a></p>
  </article>
</BaseLayout>

<!-- 本页专属样式 -->
<style>
  /* 文章标题字号与间距 */
  .post h1 { font-size: 32px; line-height: 1.3; margin: 24px 0 12px; letter-spacing: -0.3px; }

  /* 元信息行：横向排列并留出间距 */
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; color: var(--text-dim); font-size: 14px; margin-bottom: 28px; }

  /* 标签样式：淡背景 + 圆角 */
  .tag { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; font-size: 13px; }

  /* 正文基础排版 */
  .content { font-size: 16.5px; }

  /* 正文标题间距 */
  .content :global(h2) { font-size: 22px; margin: 32px 0 12px; }

  /* 正文小标题间距 */
  .content :global(h3) { font-size: 18px; margin: 24px 0 10px; }

  /* 正文段落间距 */
  .content :global(p) { margin: 0 0 16px; }

  /* 正文强调色链接 */
  .content :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  /* 正文列表缩进 */
  .content :global(ul) { padding-left: 22px; }

  /* 行内代码样式 */
  .content :global(code) { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; font-size: 0.9em; }

  /* 引用块样式：左侧强调色竖线 */
  .content :global(blockquote) { border-left: 3px solid var(--accent); margin: 0 0 16px; padding: 4px 16px; color: var(--text-dim); }

  /* 返回链接样式 */
  .back { margin-top: 40px; color: var(--text-dim); }

  /* 返回链接悬停变强调色 */
  .back a:hover { color: var(--accent); }
</style>