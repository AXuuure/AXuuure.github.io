---
// 引入全站布局组件
import BaseLayout from '../layouts/BaseLayout.astro';
// 从 astro:content 引入集合查询方法
import { getCollection } from 'astro:content';

// 读取全部博客文章
const posts = await getCollection('blog');
// 按发布日期从新到旧排序
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// 首页只展示最近 3 篇，避免列表过长
const latest = sorted.slice(0, 3);
// 三个板块的入口配置
const sections = [
  // 博客板块入口
  { href: '/blog', title: '博客', desc: '把想清楚的写下来', icon: '✎' },
  // 实验室板块入口
  { href: '/playground', title: '实验室', desc: '一些有趣的页面交互', icon: '✦' },
  // 作品集板块入口（页面留待下一阶段实现）
  { href: '/portfolio', title: '作品集', desc: '做过的东西与项目', icon: '◈' },
];
// 将日期格式化为「年-月-日」用于列表展示
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<!-- 使用全站布局，并传入首页标题 -->
<BaseLayout title="首页">
  <!-- 首屏：个人介绍 -->
  <section class="hero">
    <!-- 主标题 -->
    <h1>你好，我是 xuhuajian</h1>
    <!-- 一句话简介 -->
    <p class="lead">
      这里是我的个人站点，记录思考、作品，以及一些纯粹为了好玩写下的交互实验。
    </p>
  </section>

  <!-- 三大板块入口卡片：遍历 sections 依次渲染 -->
  <section class="sections">
    {sections.map((s) => (
      <a class="card" href={s.href}>
        <span class="icon">{s.icon}</span>
        <strong>{s.title}</strong>
        <span class="desc">{s.desc}</span>
      </a>
    ))}
  </section>

  <!-- 最新文章区域 -->
  <section class="latest">
    <!-- 区域标题 -->
    <h2>最新文章</h2>
    <!-- 无文章时给出提示（条件渲染） -->
    {latest.length === 0 && <p class="empty">还没有文章，去写第一篇吧。</p>}
    <!-- 文章列表：遍历 latest，渲染每篇的标题与日期 -->
    <ul class="post-list">
      {latest.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{formatDate(post.data.pubDate)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<!-- 首页专属样式，仅作用于本页 -->
<style>
  /* 首屏区域：上下留出较多空间 */
  .hero { padding: 48px 0 16px; }

  /* 首屏主标题字号与字距 */
  .hero h1 { font-size: 40px; line-height: 1.25; margin: 0 0 12px; letter-spacing: -0.5px; }

  /* 首屏导语：次要颜色、限制宽度提升可读性 */
  .lead { color: var(--text-dim); font-size: 17px; max-width: 560px; margin: 0; }

  /* 板块卡片：三列网格布局 */
  .sections { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 40px 0; }

  /* 卡片外观：次级背景 + 边框 + 圆角 */
  .card {
    /* 纵向排列内容 */
    display: flex; flex-direction: column; gap: 6px;
    /* 内边距 */
    padding: 18px;
    /* 卡片背景与边框 */
    background: var(--bg-soft); border: 1px solid var(--border); border-radius: 12px;
    /* 悬停过渡效果 */
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  /* 卡片悬停：边框变强调色并轻微上浮 */
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }

  /* 卡片图标：使用强调色 */
  .card .icon { color: var(--accent); font-size: 20px; }

  /* 卡片描述文字：次要颜色与小字号 */
  .card .desc { color: var(--text-dim); font-size: 14px; }

  /* 区域标题样式 */
  h2 { font-size: 20px; margin: 0 0 14px; }

  /* 文章列表：去掉默认样式 */
  .post-list { list-style: none; padding: 0; margin: 0; }

  /* 列表项之间的分隔线 */
  .post-list li { border-bottom: 1px solid var(--border); }

  /* 文章链接：两端对齐排布标题与日期 */
  .post-list a {
    /* 弹性布局，两端对齐 */
    display: flex; justify-content: space-between; gap: 16px;
    /* 内边距与过渡 */
    padding: 14px 4px; transition: color 0.2s ease;
  }

  /* 文章链接悬停变为强调色 */
  .post-list a:hover { color: var(--accent); }

  /* 文章日期：次要颜色与小字号 */
  .post-date { color: var(--text-dim); font-size: 14px; flex-shrink: 0; }

  /* 空状态提示文字 */
  .empty { color: var(--text-dim); }

  /* 小屏适配：卡片改为单列 */
  @media (max-width: 640px) {
    /* 缩小首屏标题字号 */
    .hero h1 { font-size: 30px; }
    /* 卡片改为单列排列 */
    .sections { grid-template-columns: 1fr; }
  }
</style>