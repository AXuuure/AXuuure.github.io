---
import { type CollectionEntry, render } from "astro:content";
import Masthead from "@/components/blog/Masthead.astro";
import TOC from "@/components/blog/TOC.astro";
import Giscus from "@/components/Giscus.astro";
import BaseLayout from "./Base.astro";
import SeriesPanel from "@/components/SeriesPanel.astro";
import { Icon } from "astro-icon/components";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, seriesId } = post.data;

const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings } = await render(post);
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<div class="fixed left-0 top-0 z-10 flex h-16 md:h-20 w-full bg-bgColor overflow-hidden">
		<!-- Background 
			TODO: This approach is not optimal and requires improvements. 
  			- Too many absolutely positioned elements can affect performance. 
  		-->	
		<div class="absolute top-0 left-1/2 -ml-[50vw] w-screen min-h-screen pointer-events-none blur-2xl">
			<div class="absolute top-[-90%] right-[25%] w-[75%] h-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent rounded-full opacity-40 dark:opacity-25"></div>
			<div class="absolute top-[-90%] left-[25%] w-[75%] h-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent rounded-full opacity-40 dark:opacity-25"></div>
			<div class="absolute top-[-85%] right-[25%] w-[55%] h-full bg-gradient-to-b from-purple-300 via-blue-300 to-transparent rounded-full opacity-40 dark:opacity-25"></div>
			<div class="absolute top-[-85%] left-[25%] w-[55%] h-full bg-gradient-to-b from-indigo-300 via-orange-300 to-transparent rounded-full opacity-40 dark:opacity-25"></div>
			<div class="absolute top-[-75%] left-[-25%] w-[65%] h-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent rounded-full opacity-30 dark:opacity-25"></div>
			<div class="absolute top-[-75%] right-[-25%] w-[65%] h-full bg-gradient-to-b from-purple-300 via-blue-300 to-transparent rounded-full opacity-30 dark:opacity-25"></div>
			<div class="absolute top-[-85%] left-[-30%] w-[85%] h-full bg-gradient-to-b from-indigo-300 via-orange-300 to-transparent rounded-full opacity-60 dark:opacity-25"></div>
			<div class="absolute top-[-85%] right-[-30%] w-[85%] h-full bg-gradient-to-b from-orange-300 via-indigo-300 to-transparent rounded-full opacity-60 dark:opacity-25"></div>
		</div>
	</div>
 	
	<!-- NEEDS IMPROVEMENT!!! -->
	<!-- Menu button instead of the main menu -->
	<!--
	<div class="left-0 right-0 top-0 z-30 ml-auto h-0 w-fit px-2 md:absolute">
		<div class="fixed top-0 -ml-[4rem] flex space-x-2 bg-bgColor pt-8">
	-->
			<!-- Button background -->
			<!--
			<div class="fixed top-0 h-20 right-[0%] w-[50%] bg-gradient-to-l from-orange-300 via-pink-300 to-transparent  opacity-40 dark:opacity-30">
			</div>
			-->

			<!--
			 <button
				aria-expanded="false"
				aria-haspopup="menu"
				aria-label="Open main menu"
				class="hidden md:flex group text-sm relative h-8 w-16 font-medium items-center justify-center px-4 rounded-lg bg-accent-base/5 text-accent-base hover:bg-accent-base/10"
				id="toggle-navigation-menu"
				type="button"
			>
				Menu
			</button>
			-->
	<!--	
		</div>
	</div>
	-->

	<!-- SeriesPanel is inserted into the named slot "sidebar" -->
	{seriesId && (<SeriesPanel slot="sidebar" seriesId={seriesId} />)}

	<Masthead content={post} />
	
	<div class="mt-6 flex sm:grid-cols-[auto_1fr] md:items-start gap-x-8">
		<article class="grid flex-grow grid-cols-1 break-words pt-4" data-pagefind-body>
			<div class="prose prose-citrus max-w-none flex-grow prose-headings:font-semibold prose-headings:text-accent-base prose-headings:before:text-accent-two sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none">
				<slot />
			</div>
			<Giscus />
		</article>
		{!!headings.length && (
			<aside 
				id="toc-panel" 
				class="hidden fixed inset-0 z-40 overflow-y-auto bg-bgColor p-4 md:sticky md:top-20 md:z-10 md:block md:inset-auto md:h-auto md:w-[14rem] md:min-w-[14rem] md:overflow-visible md:rounded-lg md:bg-transparent md:p-0"
			>
				<TOC headings={headings} />
			</aside>
		)}
	</div>

	<!-- 回到顶部按钮：滚动超过阈值后出现；移动端放左下角，避开右下角的系列/目录浮动按钮 -->
	<button
		id="to-top-button"
		class="fixed bottom-14 left-4 md:left-auto md:right-8 z-50 flex h-12 w-12 text-light translate-y-28 items-center justify-center rounded-full bg-bgColor text-3xl drop-shadow-xl transition-all duration-300 hover:text-accent-two data-[show=true]:translate-y-0 data-[show=true]:opacity-100"
		aria-label="回到顶部"
		data-show="false"
	>
		<span class="absolute inset-0 rounded-full bg-special-lighter flex items-center justify-center" aria-hidden="true">
			<svg
				class="h-6 w-6"
				fill="none"
				focusable="false"
				stroke="currentColor"
				stroke-width="2"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
	</button>

	<!-- Series button for mobile screens -->
	{seriesId && (
		<mobile-button
			id="toggle-panel-mobile"
			class="size-12 flex items-center justify-center block sm:hidden fixed bottom-4 shadow-[0px_10px_25px_rgba(0,0,0,0.15)] border border-special-lighter right-4 z-50 rounded-lg bg-bgColor text-accent-base hover:text-bg-accent-base/90"
			aria-label="切换系列面板"
			>
				<span class="absolute inset-0 rounded-lg flex items-center justify-center bg-special-light hover:text-accent-base/90">
				<Icon class="size-8" name="solar:notes-bold"/>
			</span>
		</mobile-button>
	)}

	<!-- 移动端目录按钮：< 768px 时显示，点击拉出全屏目录面板 -->
	{!!headings.length && (
		<mobile-button
			id="toggle-toc-mobile"
			class:list={[
				"size-12 flex items-center justify-center block md:hidden fixed shadow-[0px_10px_25px_rgba(0,0,0,0.15)] border border-special-lighter right-4 z-50 rounded-lg bg-bgColor text-accent-base hover:text-accent-base/90",
				// 有系列按钮时上移，避免两个浮动按钮叠在一起
				seriesId ? "bottom-20" : "bottom-4",
			]}
			aria-label="切换目录面板"
		>
			<span class="absolute inset-0 rounded-lg flex items-center justify-center bg-special-light hover:text-accent-base/90">
				<Icon class="size-8" name="solar:clipboard-list-bold" />
			</span>
		</mobile-button>
	)}
</BaseLayout>

<!-- Copy code button -->
<script>
	// 为正文中的每个代码块注入一个「复制」按钮
	function initCopyCodeButtons() {
		// 找出页面上所有代码块
		document.querySelectorAll("pre").forEach((pre) => {
			// 已经注入过就直接跳过：初始化会在首次加载时执行两次，靠这个判断避免叠加出多个按钮
			if (pre.querySelector(".copy-code")) return;

			// 创建按钮元素
			const copyButton = document.createElement("button");
			// copy-code 既是样式锚点，也是上面「是否已注入」判断的依据
			copyButton.className =
				"copy-code absolute flex items-center justify-center bg-bgColor h-6 font-medium overflow-hidden rounded-md text-light hover:text-accent-two font-sans text-sm font-medium top-2 right-2";

			// 按钮文案由单独的 span 承载，便于控制背景色与内边距
			const buttonText = document.createElement("span");
			buttonText.innerText = "复制"; // 初始按钮文案
			buttonText.className = "flex items-center block w-full h-full px-2 bg-[var(--code-title-bg)]"; // 撑满按钮并带背景色

			copyButton.appendChild(buttonText); // 把文案 span 挂到按钮内

			// 把按钮挂进代码块
			pre.appendChild(copyButton);

			// 点击时把代码文本写入系统剪贴板
			copyButton.addEventListener("click", async () => {
				const code = pre.querySelector("code")?.textContent;
				if (code) {
					await navigator.clipboard.writeText(code);
					buttonText.innerText = "已复制"; // 复制成功后切换文案

					// 1.5 秒后把文案恢复为「复制」
					setTimeout(() => {
						buttonText.innerText = "复制";
					}, 1500);
				}
			});
		});
	}

	// 首次加载时立即初始化
	initCopyCodeButtons();
	// 客户端导航后 body 会被整体替换，需要重新注入
	document.addEventListener("astro:page-load", initCopyCodeButtons);
</script>

<script>
	// 面板展开 / 收起的动画时长（毫秒）
	const ANIMATION_DURATION = 300;

	// 初始化系列面板的交互
	function initSeriesPanel() {
		// 获取面板与各切换/关闭按钮元素
		const togglePanelBtn = document.getElementById("toggle-panel");
		const closePanelBtn = document.getElementById("close-panel");
		const seriesPanel = document.getElementById("series-panel");
		const togglePanelMobileBtn = document.getElementById("toggle-panel-mobile");

		// 文章未加入任何系列时页面上不存在该面板，直接跳过初始化（否则会往控制台抛错）
		if (!seriesPanel) return;

		// 判断面板当前是否可见
		const isPanelVisible = () => {
			const isScreenLg = window.matchMedia("(min-width: 1024px)").matches; // 大屏
			return (
				(isScreenLg && seriesPanel.classList.contains("lg:block")) ||
				(!isScreenLg && !seriesPanel.classList.contains("hidden"))
			);
		};

		// 隐藏面板
		const hidePanel = () => {
			seriesPanel.classList.add("opacity-0", "-translate-x-full");
			setTimeout(() => {
				seriesPanel.classList.remove("block", "lg:block");
				seriesPanel.classList.add("hidden");
			}, ANIMATION_DURATION);
		};

		// 显示面板
		const showPanel = () => {
			seriesPanel.classList.remove("hidden");
			seriesPanel.classList.add("block", "lg:block");
			setTimeout(() => {
				seriesPanel.classList.remove("opacity-0", "-translate-x-full");
			}, 10);
		};

		// 桌面端与移动端按钮共用的切换逻辑
		const togglePanel = () => {
			if (isPanelVisible()) {
				hidePanel();
			} else {
				showPanel();
			}
		};

		// 绑定按钮的小工具：用 dataset 做幂等标记，避免重复绑定导致一次点击切换两下
		const bind = (el: HTMLElement | null, handler: () => void) => {
			if (!el || el.dataset.bound === "true") return;
			el.dataset.bound = "true";
			el.addEventListener("click", handler);
		};

		// 依次绑定：桌面端切换按钮、移动端切换按钮、面板内的关闭按钮
		bind(togglePanelBtn, togglePanel);
		bind(togglePanelMobileBtn, togglePanel);
		bind(closePanelBtn, hidePanel);
	}

	// 首次加载时立即初始化
	initSeriesPanel();
	// 客户端导航后 DOM 被替换，需要重新初始化
	document.addEventListener("astro:page-load", initSeriesPanel);
</script>

<script>
	// 初始化目录（TOC）面板的交互
	function initTocPanel() {
		// 获取目录面板与各切换/关闭按钮元素
		const toggleTocBtn = document.getElementById('toggle-toc');
		const closeTocBtn = document.getElementById('close-toc');
		const tocPanel = document.getElementById('toc-panel');
		const toggleTocMobileBtn = document.getElementById("toggle-toc-mobile");

		// 文章没有标题层级时页面上不存在目录面板，直接跳过初始化（否则会往控制台抛错）
		if (!tocPanel) return;

		// 判断目录当前是否可见
		const isTocVisible = () => {
			const isScreenMd = window.matchMedia("(min-width: 768px)").matches;
			return (
				(isScreenMd && tocPanel.classList.contains("md:block")) ||
				(!isScreenMd && !tocPanel.classList.contains("hidden"))
			);
		};

		// 隐藏目录
		const hideToc = () => {
			tocPanel.classList.add('hidden');
			tocPanel.classList.remove('md:block');
		};

		// 显示目录
		const showToc = () => {
			tocPanel.classList.remove('hidden');
			tocPanel.classList.add('md:block');
		};

		// 桌面端与移动端按钮共用的切换逻辑
		const toggleToc = () => {
			if (isTocVisible()) {
				hideToc();
			} else {
				showToc();
			}
		};

		// 绑定按钮的小工具：用 dataset 做幂等标记，避免重复绑定导致一次点击切换两下
		const bind = (el: HTMLElement | null, handler: () => void) => {
			if (!el || el.dataset.bound === "true") return;
			el.dataset.bound = "true";
			el.addEventListener("click", handler);
		};

		// 依次绑定：桌面端切换按钮、移动端切换按钮、面板内的关闭按钮
		bind(toggleTocBtn, toggleToc);
		bind(toggleTocMobileBtn, toggleToc);
		bind(closeTocBtn, hideToc);
	}

	// 首次加载时立即初始化
	initTocPanel();
	// 客户端导航后 DOM 被替换，需要重新初始化
	document.addEventListener("astro:page-load", initTocPanel);
</script>

<script>
	// 初始化头部右上角的按钮面板（搜索 + 主题切换）
	function initButtonsPanel() {
		const buttonsPanel = document.getElementById("buttons-panel");
		
		if (buttonsPanel) {
			buttonsPanel.classList.add("fixed");
			console.log("Class 'fixed' added to the buttons-panel element.");
		} else {
			console.error("Element with ID 'buttons-panel' not found.");
		}
	}

	// 首次加载时立即初始化
	initButtonsPanel();
	// 客户端导航后 DOM 被替换，需要重新初始化
	document.addEventListener("astro:page-load", initButtonsPanel);
</script>

<!-- 回到顶部按钮的显示逻辑 -->
<script>
	// 向下滚动超过该像素数后才显示按钮
	const SCROLL_THRESHOLD = 300;
	// 保存上一次注册的 window 级滚动监听的清理函数，避免多次导航后监听不断叠加
	let cleanupToTop: (() => void) | undefined;

	// 初始化「回到顶部」按钮
	function initToTop() {
		// 先把上一次注册的监听清掉（首次执行时为空操作）
		cleanupToTop?.();
		cleanupToTop = undefined;

		// 获取按钮元素（页面不存在该按钮时跳过，避免报错）
		const scrollBtn = document.getElementById("to-top-button") as HTMLButtonElement | null;
		if (!scrollBtn) return;

		// 根据当前滚动位置切换显示状态
		// 原先用 IntersectionObserver 监听 <header>，但 header 在移动端是 fixed 的，永远处于可视区，导致按钮从不出现
		const updateScrollBtn = () => {
			scrollBtn.dataset.show = (window.scrollY > SCROLL_THRESHOLD).toString();
		};

		// 点击后平滑滚回顶部
		const scrollToTop = () => {
			window.scrollTo({ behavior: "smooth", top: 0 });
		};
		scrollBtn.addEventListener("click", scrollToTop);

		// 监听滚动（passive 不阻塞滚动），并先同步一次初始状态
		window.addEventListener("scroll", updateScrollBtn, { passive: true });
		updateScrollBtn();

		// 记录清理函数：window 上的监听不会随 DOM 替换自动消失，必须手动移除
		cleanupToTop = () => {
			window.removeEventListener("scroll", updateScrollBtn);
			scrollBtn.removeEventListener("click", scrollToTop);
		};
	}

	// 首次加载时立即初始化
	initToTop();
	// 客户端导航后 DOM 被替换，需要重新初始化
	document.addEventListener("astro:page-load", initToTop);
</script>

