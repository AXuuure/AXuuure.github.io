---
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import TopicCard from "@/components/blog/TopicCard.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import { TOPICS, parseTopic } from "@/data/taxonomy";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
	// 每页展示的文章数
	const MAX_POSTS_PER_PAGE = 5;
	const allPosts = await getAllPosts();
	// 标签云已从侧栏移除，不再需要预先计算 uniqueTags
	return paginate(allPosts.sort(collectionDateSort), { pageSize: MAX_POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	// 分页后的当前页数据
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const meta = {
	description: "我的文章集合，以及我感兴趣的内容",
	title: "博客",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← 上一页",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一页 →",
			url: page.url.next,
		},
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

// 题材卡片数据：每个题材的篇数与界定句（仅第 1 页渲染）
const allPosts = await getAllPosts();
const topicStats = TOPICS.map((topic) => ({
	slug: topic.slug,
	label: topic.label,
	description: topic.description,
	// 属于该题材的文章数；v2 已删除按体裁的细分计数
	total: allPosts.filter((post) => parseTopic(post.id) === topic.slug).length,
}));
---

<PageLayout meta={meta}>
	<h1 class="title mb-6 flex items-center gap-2">
		博客
		<a class="text-accent-two" href="/rss.xml" target="_blank">
			<span class="sr-only">RSS 订阅</span>
			<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
		</a>
	</h1>

	<!-- 题材导航：只在第 1 页出现，分页后的页面不重复 -->
	{
		page.currentPage === 1 && (
			<section aria-label="题材导航" class="mb-10">
				<h2 class="title mb-4">题材</h2>
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{topicStats.map((topic) => (
						<TopicCard
							slug={topic.slug}
							label={topic.label}
							description={topic.description}
							total={topic.total}
						/>
					))}
				</div>
			</section>
		)
	}

	<section aria-label="博客文章列表">
		{
			descYearKeys.map((yearKey) => (
				<>
					<h4 class="title">{yearKey}</h4>
					<ul class="mb-8 mt-4 space-y-8 text-start">
						{groupedByYear[yearKey]?.map((p) => (
							<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
								<PostPreview post={p} withDesc={true} />
							</li>
						))}
					</ul>
				</>
			))
		}
	</section>

	<Pagination {...paginationProps} />
</PageLayout>
