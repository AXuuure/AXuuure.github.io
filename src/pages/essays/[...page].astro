---
import { type CollectionEntry, getCollection } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import Essay from "@/components/essay/Essay.astro";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async ({ paginate }) => {
	// 每页展示的随笔条数
	const MAX_ESSAYS_PER_PAGE = 5;
	// 取随笔集合的全部条目
	const allEssays = await getCollection("essay");
	return paginate(allEssays.sort(collectionDateSort), { pageSize: MAX_ESSAYS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	// 分页后的当前页数据
	page: Page<CollectionEntry<"essay">>;
}

const { page } = Astro.props;

const meta = {
	description: "我的随笔集合：思考、记录与碎想",
	title: "随笔",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← 上一页",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一页 →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-6 flex items-center gap-2">
			随笔
			{/* RSS 订阅入口：路径已随集合改名同步为 /essays/rss.xml */}
			<a class="text-accent-two" href="/essays/rss.xml" target="_blank">
				<span class="sr-only">RSS 订阅</span>
				<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
			</a>
		</h1>
		<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
			{/* 遍历当前页随笔条目，渲染预览卡片 */}
			{
				page.data.map((essay) => (
					<div>
						<Essay essay={essay} as="h4" isPreview />
					</div>
				))
			}
		</div>

		<Pagination {...paginationProps} />
	</section>
</PageLayout>
