---
// 定义组件接收的属性类型
interface Props {
  // 页面标题：显示在浏览器标签页
  title: string;
  // 页面描述：默认值用于 SEO 与分享预览
  description?: string;
}

// 解构属性并给 description 设置默认值
const { title, description = '一个记录博客、作品与交互实验的个人站点' } = Astro.props;
// 拼接完整标题：页面标题 + 站点名后缀
const pageTitle = `${title} | xuhuajian`;
// 读取当前访问路径，用于导航高亮判断
const currentPath = Astro.url.pathname;
// 导航配置：每一项包含链接地址与展示文案
const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/playground', label: '实验室' },
];
// 判断某个导航项是否为当前页：首页需精确匹配，其余按前缀匹配
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<!doctype html>
<!-- 声明页面语言为简体中文 -->
<html lang="zh-CN">
  <head>
    <!-- 声明字符编码，避免中文乱码 -->
    <meta charset="utf-8" />
    <!-- 移动端视口设置，保证响应式布局正常 -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 页面描述，利于搜索引擎收录与分享预览 -->
    <meta name="description" content={description} />
    <!-- SVG 站点图标 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 输出 Astro 生成器信息 -->
    <meta name="generator" content={Astro.generator} />
    <!-- 浏览器标签页标题 -->
    <title>{pageTitle}</title>
  </head>
  <body>
    <!-- 顶部导航栏 -->
    <header class="site-header">
      <!-- 站点标识，点击返回首页 -->
      <a class="brand" href="/">xuhuajian</a>
      <!-- 主导航容器 -->
      <nav>
        <!-- 遍历导航配置渲染链接，并为当前页添加高亮类 -->
        {navItems.map((item) => (
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a>
        ))}
      </nav>
    </header>
    <!-- 主内容区，各页面通过 slot 注入 -->
    <main class="container">
      <slot />
    </main>
    <!-- 页脚区域 -->
    <footer class="site-footer">
      <!-- 版权信息，年份动态生成 -->
      <p>© {new Date().getFullYear()} xuhuajian · 用 Astro 构建</p>
    </footer>
    <!-- 全局样式：作用于全站所有页面 -->
    <style is:global>
      /* 定义全站设计变量，便于统一调整主题 */
      :root {
        /* 强调色：用于链接与高亮 */
        --accent: #3ddc97;
        /* 页面背景色 */
        --bg: #0d1117;
        /* 卡片等次级背景色 */
        --bg-soft: #161b22;
        /* 边框颜色 */
        --border: #263041;
        /* 正文文字颜色 */
        --text: #e6edf3;
        /* 次要文字颜色 */
        --text-dim: #8b949e;
        /* 内容区最大宽度 */
        --maxw: 760px;
      }

      /* 统一盒模型，宽度计算更直观 */
      * { box-sizing: border-box; }

      /* 页面整体基础样式 */
      body {
        /* 清除浏览器默认外边距 */
        margin: 0;
        /* 应用页面背景色 */
        background: var(--bg);
        /* 应用正文文字颜色 */
        color: var(--text);
        /* 设置字体栈，优先使用系统字体以保证中文显示效果 */
        font-family: ui-sans-serif, system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
        /* 设置行高，提升长文可读性 */
        line-height: 1.7;
        /* 开启字体抗锯齿，让文字更平滑 */
        -webkit-font-smoothing: antialiased;
      }

      /* 链接默认继承文字颜色并去掉下划线 */
      a { color: inherit; text-decoration: none; }

      /* 顶部导航栏布局：两端对齐 */
      .site-header {
        /* 使用弹性布局排布子元素 */
        display: flex;
        /* 品牌在左、导航在右 */
        justify-content: space-between;
        /* 子元素垂直居中 */
        align-items: center;
        /* 限制最大宽度并水平居中 */
        max-width: var(--maxw);
        margin: 0 auto;
        /* 设置内边距，保持与内容区对齐 */
        padding: 20px 24px;
      }

      /* 站点标识文字样式 */
      .brand { font-weight: 700; letter-spacing: 0.5px; }

      /* 导航容器：横向排列并设置间距 */
      .site-header nav { display: flex; gap: 18px; }

      /* 导航链接默认样式：次要颜色 + 过渡动画 */
      .site-header nav a { color: var(--text-dim); font-size: 15px; transition: color 0.2s ease; }

      /* 导航链接悬停时提亮 */
      .site-header nav a:hover { color: var(--text); }

      /* 当前页导航高亮为强调色 */
      .site-header nav a.active { color: var(--accent); }

      /* 主内容区容器：限制宽度并居中 */
      .container { max-width: var(--maxw); margin: 0 auto; padding: 24px; }

      /* 页脚样式：弱化颜色、拉开与正文的距离 */
      .site-footer { max-width: var(--maxw); margin: 64px auto 40px; padding: 0 24px; color: var(--text-dim); font-size: 14px; }
    </style>
  </body>
</html>