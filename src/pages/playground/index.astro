---
// 引入全站布局组件
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<!-- 使用全站布局，并传入本页标题 -->
<BaseLayout title="实验室" description="一些有趣的页面交互实验">
  <!-- 页面标题 -->
  <h1 class="page-title">实验室</h1>
  <!-- 说明文字 -->
  <p class="intro">这里放一些纯为了好玩写的交互。下面是第一个实验：移动鼠标，看粒子如何被吸引。</p>

  <!-- 画布容器：限制尺寸与圆角 -->
  <div class="stage">
    <!-- 粒子画布，脚本会在这里绘制 -->
    <canvas id="scene"></canvas>
  </div>

  <!-- 实验说明 -->
  <p class="note">实验 01 · 粒子星座：粒子自由漂浮，靠近彼此或鼠标时会连成线。</p>
</BaseLayout>

<!-- 页面专属样式 -->
<style>
  /* 页面标题字号 */
  .page-title { font-size: 30px; margin: 24px 0 6px; }

  /* 说明文字 */
  .intro { color: var(--text-dim); margin: 0 0 20px; }

  /* 画布容器：圆角边框与溢出裁剪 */
  .stage { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--bg-soft); }

  /* 画布铺满容器并设定高度 */
  canvas { display: block; width: 100%; height: 420px; touch-action: none; }

  /* 底部说明文字 */
  .note { color: var(--text-dim); font-size: 14px; margin-top: 14px; }

  /* 小屏下降低画布高度 */
  @media (max-width: 640px) {
    /* 缩短画布高度，适配手机 */
    canvas { height: 300px; }
  }
</style>

<script>
  // 获取画布元素
  const canvas = document.getElementById('scene');
  // 获取 2D 绘制上下文
  const ctx = canvas.getContext('2d');
  // 读取设备像素比（上限 2），用于高清屏清晰渲染
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  // 存放所有粒子的数组
  let particles = [];
  // 记录指针位置，初始放在画布外表示无交互
  const pointer = { x: -9999, y: -9999 };

  // 根据容器尺寸初始化画布与粒子
  function setup() {
    // 读取画布在 CSS 像素下的宽度
    const w = canvas.clientWidth;
    // 读取画布在 CSS 像素下的高度
    const h = canvas.clientHeight;
    // 按设备像素比设置画布的真实分辨率
    canvas.width = w * dpr;
    // 同上，设置高度分辨率
    canvas.height = h * dpr;
    // 缩放绘制上下文，让后续坐标按 CSS 像素计算
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    // 依据画布面积估算粒子数量，并限制在 40 到 140 之间
    const count = Math.round(Math.min(Math.max((w * h) / 12000, 40), 140));
    // 生成粒子数组，每个粒子带随机位置与速度
    particles = Array.from({ length: count }, () => ({
      // 随机初始横坐标
      x: Math.random() * w,
      // 随机初始纵坐标
      y: Math.random() * h,
      // 随机横向速度（-0.3 ~ 0.3）
      vx: (Math.random() - 0.5) * 0.6,
      // 随机纵向速度（-0.3 ~ 0.3）
      vy: (Math.random() - 0.5) * 0.6,
    }));
  }

  // 绘制一帧动画
  function draw() {
    // 读取当前 CSS 像素宽度
    const w = canvas.clientWidth;
    // 读取当前 CSS 像素高度
    const h = canvas.clientHeight;
    // 清空上一帧的内容
    ctx.clearRect(0, 0, w, h);

    // 遍历每个粒子：更新位置并画点
    for (const p of particles) {
      // 按横向速度移动
      p.x += p.vx;
      // 按纵向速度移动
      p.y += p.vy;
      // 撞到左右边界则水平反弹
      if (p.x < 0 || p.x > w) p.vx *= -1;
      // 撞到上下边界则垂直反弹
      if (p.y < 0 || p.y > h) p.vy *= -1;
      // 开始一条新的绘制路径
      ctx.beginPath();
      // 在粒子位置画一个半径 1.8 的圆
      ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
      // 设置填充色为半透明强调色
      ctx.fillStyle = 'rgba(61, 220, 151, 0.75)';
      // 填充圆点
      ctx.fill();
    }

    // 计算并绘制粒子之间的连线
    for (let i = 0; i < particles.length; i++) {
      // 与后面的每个粒子逐一比较，避免重复计算
      for (let j = i + 1; j < particles.length; j++) {
        // 计算两点横向距离
        const dx = particles[i].x - particles[j].x;
        // 计算两点纵向距离
        const dy = particles[i].y - particles[j].y;
        // 计算两点直线距离
        const dist = Math.hypot(dx, dy);
        // 仅在距离小于 110 时才连线
        if (dist < 110) {
          // 距离越近，线条越不透明
          ctx.strokeStyle = `rgba(139, 148, 158, ${(1 - dist / 110) * 0.28})`;
          // 设置线宽为 1 像素
          ctx.lineWidth = 1;
          // 开始一条新的路径
          ctx.beginPath();
          // 从第一个粒子开始画线
          ctx.moveTo(particles[i].x, particles[i].y);
          // 连到第二个粒子
          ctx.lineTo(particles[j].x, particles[j].y);
          // 描边输出这条线
          ctx.stroke();
        }
      }
    }

    // 绘制粒子与指针之间的高亮连线
    for (const p of particles) {
      // 计算粒子到指针的距离
      const dist = Math.hypot(p.x - pointer.x, p.y - pointer.y);
      // 仅在距离小于 160 时连线
      if (dist < 160) {
        // 越靠近指针，线条越亮
        ctx.strokeStyle = `rgba(61, 220, 151, ${(1 - dist / 160) * 0.5})`;
        // 设置线宽为 1 像素
        ctx.lineWidth = 1;
        // 开始一条新的路径
        ctx.beginPath();
        // 从粒子开始画线
        ctx.moveTo(p.x, p.y);
        // 连到指针位置
        ctx.lineTo(pointer.x, pointer.y);
        // 描边输出这条线
        ctx.stroke();
      }
    }

    // 请求下一帧，形成连续的动画循环
    requestAnimationFrame(draw);
  }

  // 指针在画布上移动时更新坐标
  canvas.addEventListener('pointermove', (event) => {
    // 获取画布相对视口的位置
    const rect = canvas.getBoundingClientRect();
    // 换算指针在画布内的横坐标
    pointer.x = event.clientX - rect.left;
    // 换算指针在画布内的纵坐标
    pointer.y = event.clientY - rect.top;
  });
  // 指针离开画布时把位置移出可视区域，取消高亮
  canvas.addEventListener('pointerleave', () => {
    // 横坐标移到画布外
    pointer.x = -9999;
    // 纵坐标移到画布外
    pointer.y = -9999;
  });
  // 窗口尺寸变化时重新计算画布尺寸与粒子布局
  window.addEventListener('resize', setup);

  // 首次进入页面时初始化
  setup();
  // 启动动画循环
  requestAnimationFrame(draw);
</script>